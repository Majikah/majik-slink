    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majikah/majik-slink.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jedlsf"
  },
  "keywords": [
    "url-verification",
    "identity-linking",
    "ownership-proof",
    "cryptographic-signature",
    "post-quantum",
    "ml-dsa",
    "ed25519",
    "canonical-urls",
    "web-identity",
    "trustless-verification",
    "majikah",
